# No trailing slashes: these are symlinks to another disk in this checkout, and a
# "dir/" pattern does not match a symlink.

# virtualenv (points at a 1 GB tree)
.venv
venv

# generated episode data and trained checkpoints: 27 MB of binaries, reproducible
# by re-running stage 5
data

# the manuscript is kept out of this repo deliberately
final_paper_writeup

__pycache__/
*.py[cod]
.ipynb_checkpoints/
.DS_Store

# v1 development campaign, preserved for provenance but not tracked (regenerable,
# and mixing it with the corrected campaign is exactly what must not happen)
data_v1_archive

# 46 MB each, and the `rows` they carry are the same records as pathb_rollouts*.csv.
# The tracked pathb5_test*_summary.json keeps the plan, counts, ledger and constants.
results/pathb5_test.json
results/pathb5_test_Rcorrected.json

# manuscript sources from the mentor's Path B drop: same rule as final_paper_writeup,
# the paper itself stays out of a public repo. The plan and review notes are tracked.
pathB/*.tex
pathB/*.pdf
pathB/*.cls
pathB/refs.bib

# the mentor drop archive: carries main.tex/main.pdf, so it is covered by the rule above
Multimodal_Context_Learning_RAL_PathB_*.zip
