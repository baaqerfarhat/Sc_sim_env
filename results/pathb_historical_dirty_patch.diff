+        A, B = CT.error_jacobians(r_now, r_next)
+        Pc = np.linalg.cholesky(self.P).T          # P = Pc' Pc
+        M = Pc @ B
+        c = Pc @ (A @ e_k - B @ u_r + d_r)
+        rho = self.lam * CT.norm_P(e_k, self.P) + CT.norm_P(d_r, self.P)
